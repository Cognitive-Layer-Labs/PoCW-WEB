# Server-only settings. The browser never sees these values.

# ── Engine ───────────────────────────────────────────────────────────────────
# Base URL of the PoCW engine (no trailing /api). Defaults to http://engine:3000.
ENGINE_URL=http://engine:3000
# Bearer token the engine expects on /api/* (the engine's POCW_API_KEY).
ENGINE_API_KEY=change-me

# ── Sign-in (Google) ─────────────────────────────────────────────────────────
# Public URL of this app, no trailing slash. Used for the OAuth callback
# (${AUTH_URL}/api/auth/callback/google), share links and cookie security
# (https => Secure, __Host- cookies).
AUTH_URL=https://bookmap.baghici.com
# Long random string that signs sessions and the OAuth state cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
# OAuth client from Google Cloud Console (Web application).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails that can open /admin.
ADMIN_EMAILS=gabibaghici1@gmail.com
# Shown on /privacy and /terms for data requests (default: first ADMIN_EMAILS entry).
CONTACT_EMAIL=

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory for bookmap.db (SQLite). Docker image default: /app/data (a volume).
DATA_DIR=./data

# AUTH_DEV_LOGIN=1 enables a password-less /dev-login for automated tests.
# NEVER set it on a public server: anyone could sign in as anyone.
