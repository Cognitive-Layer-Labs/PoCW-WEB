# Server-only settings for the Next.js route handler that proxies to the PoCW engine.
# The browser never sees these values and never talks to the engine directly.

# Base URL of the engine (no trailing /api). Defaults to http://engine:3000.
ENGINE_URL=http://engine:3000

# Bearer token the engine expects on /api/* (the engine's POCW_API_KEY).
ENGINE_API_KEY=change-me
